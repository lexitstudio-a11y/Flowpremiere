{
  "id": "com.lexitstudio.keyframeease",
  "name": "Keyframe Ease",
  "shortname": "KeyframeEase",
  "version": "0.1.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "26.2.0"
  },
  "manifestVersion": 5,
  "entrypoints": [
    {
      "id": "keyframeEasePanel",
      "type": "panel",
      "label": {
        "default": "Keyframe Ease"
      },
      "minimumSize": {
        "width": 260,
        "height": 420
      },
      "maximumSize": {
        "width": 2000,
        "height": 2000
      },
      "preferredDockedSize": {
        "width": 300,
        "height": 560
      },
      "preferredFloatingSize": {
        "width": 300,
        "height": 560
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/dark.svg",
          "scale": [1, 2],
          "theme": ["darkest", "dark", "medium"]
        },
        {
          "width": 23,
          "height": 23,
          "path": "icons/light.svg",
          "scale": [1, 2],
          "theme": ["lightest", "light"]
        }
      ]
    }
  ],
  "icons": [
    {
      "width": 48,
      "height": 48,
      "path": "icons/plugin-icon.svg",
      "scale": [1, 2],
      "theme": ["darkest", "dark", "medium", "lightest", "light", "all"],
      "species": ["pluginList"]
    }
  ]
}
